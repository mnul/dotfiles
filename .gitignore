# ~/.gitignore

# Homelab Secret Safeguards (Public Repo Protection)
/.ssh/
/ssh-keys/
*.pem
*.key
*.p12
.env
.env.*
secrets.yaml
vault_pass.txt

# Shell History Inclusions
.bash_history
.zsh_history
.python_history
.node_repl_history

# LLM Context Dump & Installation Backups
*.llm.txt
*.dtbak

# Dev Environment Metadata & Caches
.terraform/
*.tfstate
*.tfstate.backup
**/__pycache__/
*.py[cod]
node_modules/

# OS & Editor Artifacts
*~
.*.swp
.*.swo
\.#*
.DS_Store
.directory